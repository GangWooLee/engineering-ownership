{
  "actions": [
    {
      "action": "run",
      "target": "git status && echo \"---\" && git log --oneline -10 && echo \"---\" && git diff --stat"
    },
    {
      "action": "search",
      "target": "**/*.md"
    },
    {
      "action": "read",
      "target": "docs/proposals/settlement-currency.md"
    },
    {
      "action": "read",
      "target": "plans/settlement-currency.md"
    },
    {
      "action": "run",
      "target": "git diff src/db/schema.py; echo \"---CONTRACT---\"; ls -la .engineering 2>/dev/null || echo \"no .engineering dir\"; echo \"---AGENTS---\"; cat AGENTS.md 2>/dev/null "
    },
    {
      "action": "read",
      "target": "docs/engineering/changes/partner-settlement-rounding.md"
    },
    {
      "action": "read",
      "target": "docs/engineering/decisions/partner-settlement-rounding.md"
    },
    {
      "action": "run",
      "target": "cat (outside the repository) 2>/dev/null || find (outside the repository) -path */(outside the repository)/skills/(outside the repository)/references* 2>/dev/null"
    },
    {
      "action": "read",
      "target": "(outside the repository)"
    },
    {
      "action": "read",
      "target": ".engineering/contract.json"
    },
    {
      "action": "read",
      "target": "(outside the repository)"
    },
    {
      "action": "read",
      "target": "(outside the repository)"
    },
    {
      "action": "run",
      "target": "which engineering 2>/dev/null; echo \"---\"; find (outside the repository) -maxdepth 3 -iname \"bin\" -o -iname \"engineering\" 2>/dev/null | head -20"
    },
    {
      "action": "run",
      "target": "engineering status --all 2>&1"
    },
    {
      "action": "run",
      "target": "engineering change start settlement-currency --risk R2 --title \"Carry settlement currency on the order\" 2>&1"
    },
    {
      "action": "run",
      "target": "cat docs/engineering/changes/settlement-currency.md; echo \"===ADR===\"; cat docs/engineering/decisions/settlement-currency.md"
    },
    {
      "action": "run",
      "target": "find src -type f | xargs -I{} echo {}"
    },
    {
      "action": "read",
      "target": "src/api/partner_adapter.py"
    },
    {
      "action": "search",
      "target": "currency"
    },
    {
      "action": "write",
      "target": "docs/engineering/changes/settlement-currency.md"
    },
    {
      "action": "write",
      "target": "docs/engineering/decisions/settlement-currency.md"
    },
    {
      "action": "write",
      "target": "docs/engineering/decisions/settlement-currency.md"
    },
    {
      "action": "write",
      "target": "docs/engineering/changes/settlement-currency.md"
    },
    {
      "action": "run",
      "target": "engineering verify settlement-currency 2>&1; echo \"---STATUS---\"; engineering status --all 2>&1"
    },
    {
      "action": "run",
      "target": "engineering check --mode advise --change settlement-currency 2>&1"
    },
    {
      "action": "write",
      "target": "docs/engineering/changes/settlement-currency.md"
    }
  ]
}
