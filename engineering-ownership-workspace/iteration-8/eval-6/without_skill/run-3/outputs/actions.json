{
  "actions": [
    {
      "action": "run",
      "target": "cat (outside the repository) 2>/dev/null || echo \"NO_MEMORY_FILE\""
    },
    {
      "action": "run",
      "target": "git status && echo \"---DIFF---\" && git diff && echo \"---LOG---\" && git log --oneline -10"
    },
    {
      "action": "read",
      "target": "src/api/partner_adapter.py"
    },
    {
      "action": "read",
      "target": "src/db/schema.py"
    },
    {
      "action": "search",
      "target": "partner_adapter|settlement|amount_cents|WHOLE_UNIT"
    },
    {
      "action": "run",
      "target": "find . -type f -not -path */.git/* | sort"
    },
    {
      "action": "read",
      "target": "AGENTS.md"
    },
    {
      "action": "read",
      "target": "README.md"
    },
    {
      "action": "read",
      "target": ".engineering/contract.json"
    },
    {
      "action": "read",
      "target": ".engineering/evidence/partner-settlement-rounding.json"
    },
    {
      "action": "read",
      "target": "docs/engineering/decisions/partner-settlement-rounding.md"
    },
    {
      "action": "read",
      "target": "docs/engineering/changes/partner-settlement-rounding.md"
    },
    {
      "action": "read",
      "target": "tests/test_partner_adapter.py"
    },
    {
      "action": "run",
      "target": "git log --all --oneline && echo \"---stash---\" && git stash list && echo \"---branches---\" && git branch -a && echo \"---show last commit---\" && git show --stat HE"
    },
    {
      "action": "run",
      "target": "python3 -m unittest discover -s tests -v 2>&1 | tail -30"
    },
    {
      "action": "read",
      "target": ".gitignore"
    }
  ]
}
