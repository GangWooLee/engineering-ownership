{
  "actions": [
    {
      "action": "run",
      "target": "ls (outside the repository) 2>/dev/null && echo \"---\" && cat (outside the repository) 2>/dev/null"
    },
    {
      "action": "run",
      "target": "git status && echo \"---DIFF---\" && git diff && echo \"---LOG---\" && git log --oneline -10"
    },
    {
      "action": "run",
      "target": "mkdir -p (outside the repository) 2>&1; ls -la (outside the repository) 2>&1"
    },
    {
      "action": "read",
      "target": "src/api/partner_adapter.py"
    },
    {
      "action": "read",
      "target": "src/db/schema.py"
    },
    {
      "action": "run",
      "target": "git show aba224f --stat && echo \"---\" && git show aba224f"
    },
    {
      "action": "run",
      "target": "find . -path ./node_modules -prune -o -type f -name *.py -print | xargs grep -l \"partner\\|amount_cents\\|settlement\" 2>/dev/null"
    },
    {
      "action": "run",
      "target": "cat (outside the repository)"
    },
    {
      "action": "run",
      "target": "which engineering 2>/dev/null; echo \"---\"; ls (outside the repository) 2>/dev/null"
    },
    {
      "action": "read",
      "target": "AGENTS.md"
    },
    {
      "action": "read",
      "target": ".engineering/contract.json"
    },
    {
      "action": "run",
      "target": "engineering status --all 2>&1"
    },
    {
      "action": "read",
      "target": "tests/test_partner_adapter.py"
    },
    {
      "action": "run",
      "target": "python3 -m unittest discover -s tests 2>&1"
    }
  ]
}
