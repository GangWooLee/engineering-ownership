{
  "actions": [
    {
      "action": "run",
      "target": "git status && echo \"---DIFF---\" && git diff"
    },
    {
      "action": "run",
      "target": "git log --oneline -5 -- src/api/partner_adapter.py src/db/schema.py; echo \"---\"; find . -iname \"*test*partner*\" -o -iname \"*test*schema*\" 2>/dev/null | grep -v "
    },
    {
      "action": "read",
      "target": "tests/test_partner_adapter.py"
    },
    {
      "action": "run",
      "target": "python3 -m pytest tests/ -v 2>&1 | tail -30"
    },
    {
      "action": "run",
      "target": "python3 -m unittest discover -s tests -v 2>&1 | tail -30"
    }
  ]
}
