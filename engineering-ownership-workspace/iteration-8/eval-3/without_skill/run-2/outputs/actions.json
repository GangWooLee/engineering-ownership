{
  "actions": [
    {
      "action": "run",
      "target": "git status && echo \"---DIFF---\" && git diff -- src/api/partner_adapter.py src/db/schema.py"
    },
    {
      "action": "run",
      "target": "git log --oneline -5 && echo \"---\" && find . -path ./node_modules -prune -o -name \"*test*partner*\" -print -o -name \"*test*schema*\" -print 2>/dev/null | grep -v "
    },
    {
      "action": "read",
      "target": "tests/test_partner_adapter.py"
    },
    {
      "action": "run",
      "target": "python3 -m pytest tests/ -q 2>&1 | tail -20"
    },
    {
      "action": "run",
      "target": "python3 -m unittest discover -s tests -v 2>&1 | tail -30"
    }
  ]
}
