{
  "actions": [
    {
      "action": "run",
      "target": "git status && echo \"---DIFF---\" && git diff"
    },
    {
      "action": "run",
      "target": "git log --oneline -5 && echo \"---\" && find . -path ./node_modules -prune -o -iname \"*test*\" -print 2>/dev/null | grep -v .git/"
    },
    {
      "action": "read",
      "target": "tests/test_partner_adapter.py"
    },
    {
      "action": "run",
      "target": "python3 -m pytest tests/ -v 2>&1 || python3 -m unittest discover -v 2>&1"
    }
  ]
}
