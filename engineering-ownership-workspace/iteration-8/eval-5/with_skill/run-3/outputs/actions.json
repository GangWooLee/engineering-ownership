{
  "actions": [
    {
      "action": "read",
      "target": "(outside the repository)"
    },
    {
      "action": "run",
      "target": "ls -la && git log --oneline -20"
    },
    {
      "action": "run",
      "target": "find . -maxdepth 3 -not -path */node_modules/* -not -path */.git/* | sort"
    },
    {
      "action": "read",
      "target": "AGENTS.md"
    },
    {
      "action": "read",
      "target": "CONTRIBUTING.md"
    },
    {
      "action": "read",
      "target": "README.md"
    },
    {
      "action": "read",
      "target": "docs/decisions/2026-02-settlement-amount-units.md"
    },
    {
      "action": "run",
      "target": "cat .gitignore; echo \"---\"; find . -maxdepth 1 -iname \"*.toml\" -o -iname \"*.cfg\" -o -iname \"*.ini\" -o -iname package.json -o -iname \"Makefile\" 2>/dev/null; echo"
    },
    {
      "action": "read",
      "target": "src/api/partner_adapter.py"
    },
    {
      "action": "read",
      "target": "src/db/schema.py"
    },
    {
      "action": "read",
      "target": "tests/test_partner_adapter.py"
    },
    {
      "action": "run",
      "target": "which engineering 2>/dev/null; echo \"---\"; find (outside the repository) -maxdepth 3 -iname \"*engineering*\" 2>/dev/null | head -30"
    },
    {
      "action": "run",
      "target": "ls -la .engineering 2>/dev/null && echo \"EXISTS\" || echo \"NO CONTRACT YET\"; engineering --help 2>&1 | head -50"
    },
    {
      "action": "read",
      "target": "(outside the repository)"
    },
    {
      "action": "run",
      "target": "engineering init --help 2>&1"
    },
    {
      "action": "read",
      "target": "(outside the repository)"
    },
    {
      "action": "run",
      "target": "find . -iname \"*.yml\" -o -iname \"*.yaml\" 2>/dev/null | grep -v node_modules; find . -name \".github\" -maxdepth 2; python3 -m unittest discover -s tests 2>&1 | ta"
    },
    {
      "action": "run",
      "target": "cat (outside the repository) 2>/dev/null"
    }
  ]
}
