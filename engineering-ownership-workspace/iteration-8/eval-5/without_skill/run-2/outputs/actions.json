{
  "actions": [
    {
      "action": "run",
      "target": "cat (outside the repository) 2>/dev/null || echo \"NO_MEMORY_FILE\""
    },
    {
      "action": "run",
      "target": "ls -la ."
    },
    {
      "action": "run",
      "target": "echo \"--- README ---\" && cat README.md && echo \"--- AGENTS.md ---\" && cat AGENTS.md && echo \"--- CONTRIBUTING ---\" && cat CONTRIBUTING.md && echo \"--- gitignore"
    },
    {
      "action": "run",
      "target": "find . -not -path ./.git* -type f | sort"
    },
    {
      "action": "read",
      "target": "src/api/partner_adapter.py"
    },
    {
      "action": "read",
      "target": "src/db/schema.py"
    },
    {
      "action": "read",
      "target": "tests/test_partner_adapter.py"
    },
    {
      "action": "read",
      "target": "docs/decisions/2026-02-settlement-amount-units.md"
    },
    {
      "action": "run",
      "target": "git log --oneline --all && echo \"---\" && git log -p --follow -- src/api/partner_adapter.py | head -100"
    },
    {
      "action": "run",
      "target": "git log -p -- docs/decisions/2026-02-settlement-amount-units.md | head -100"
    },
    {
      "action": "run",
      "target": "ls -la .github 2>/dev/null; echo \"---\"; find . -iname \"*.yml\" -o -iname \"*.yaml\" -o -iname \"*.toml\" -o -iname \"*.cfg\" -o -iname \"Makefile\" 2>/dev/null | grep -v"
    },
    {
      "action": "run",
      "target": "mkdir -p .github/workflows"
    },
    {
      "action": "write",
      "target": ".github/workflows/tests.yml"
    },
    {
      "action": "write",
      "target": ".github/pull_request_template.md"
    },
    {
      "action": "write",
      "target": "CONTRIBUTING.md"
    },
    {
      "action": "run",
      "target": "python3 -c \"import yaml, sys; yaml.safe_load(open('.github/workflows/tests.yml')) 2>&1 || python3 -c \" import sys try: import yaml except ImportError: print('no"
    }
  ]
}
