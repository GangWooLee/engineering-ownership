{
  "actions": [
    {
      "action": "run",
      "target": "ls (outside the repository) 2>/dev/null && echo \"---MEMORY.md---\" && cat (outside the repository) 2>/dev/null"
    },
    {
      "action": "run",
      "target": "git status && echo \"---LOG---\" && git log --oneline -20 && echo \"---DIFF---\" && git diff"
    },
    {
      "action": "run",
      "target": "mkdir -p (outside the repository) && ls -la (outside the repository)"
    },
    {
      "action": "search",
      "target": "**/*.md"
    },
    {
      "action": "run",
      "target": "ls -la ."
    },
    {
      "action": "read",
      "target": "docs/proposals/settlement-currency.md"
    },
    {
      "action": "read",
      "target": "plans/settlement-currency.md"
    },
    {
      "action": "read",
      "target": "docs/engineering/changes/partner-settlement-rounding.md"
    },
    {
      "action": "read",
      "target": "docs/engineering/decisions/partner-settlement-rounding.md"
    },
    {
      "action": "run",
      "target": "find .engineering -type f | xargs -I{} echo {}"
    },
    {
      "action": "read",
      "target": ".engineering/contract.json"
    },
    {
      "action": "read",
      "target": ".engineering/evidence/partner-settlement-rounding.json"
    },
    {
      "action": "read",
      "target": "AGENTS.md"
    },
    {
      "action": "run",
      "target": "cat (outside the repository)"
    },
    {
      "action": "run",
      "target": "cat (outside the repository)"
    },
    {
      "action": "run",
      "target": "which engineering 2>/dev/null; ls (outside the repository) 2>/dev/null; find (outside the repository) -maxdepth 2 -name \"bin\" -o -name *.py | head -20"
    },
    {
      "action": "run",
      "target": "cat (outside the repository)"
    },
    {
      "action": "run",
      "target": "engineering status --all"
    },
    {
      "action": "run",
      "target": "engineering change start settlement-currency --risk R2 --title \"Settlement currency on order\""
    },
    {
      "action": "read",
      "target": "docs/engineering/changes/settlement-currency.md"
    },
    {
      "action": "read",
      "target": "docs/engineering/decisions/settlement-currency.md"
    },
    {
      "action": "write",
      "target": "docs/engineering/changes/settlement-currency.md"
    },
    {
      "action": "write",
      "target": "docs/engineering/decisions/settlement-currency.md"
    },
    {
      "action": "run",
      "target": "grep -rn \"fill-required\" docs/engineering/changes/settlement-currency.md docs/engineering/decisions/settlement-currency.md; echo \"exit:$?\""
    },
    {
      "action": "run",
      "target": "engineering verify settlement-currency"
    },
    {
      "action": "run",
      "target": "engineering status --all && echo \"---\" && engineering check --mode advise --change settlement-currency"
    },
    {
      "action": "run",
      "target": "git status"
    }
  ]
}
