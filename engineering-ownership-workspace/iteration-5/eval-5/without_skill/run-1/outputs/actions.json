{
  "actions": [
    {
      "action": "run",
      "target": "ls -la '*/node_modules*'"
    },
    {
      "action": "run",
      "target": "git log"
    },
    {
      "action": "read",
      "target": "README.md"
    },
    {
      "action": "read",
      "target": "AGENTS.md"
    },
    {
      "action": "read",
      "target": "CONTRIBUTING.md"
    },
    {
      "action": "run",
      "target": "find . '*/.git*'"
    },
    {
      "action": "read",
      "target": "src/api/partner_adapter.py"
    },
    {
      "action": "read",
      "target": "src/db/schema.py"
    },
    {
      "action": "read",
      "target": "tests/test_partner_adapter.py"
    },
    {
      "action": "read",
      "target": "docs/decisions/2026-02-settlement-amount-units.md"
    },
    {
      "action": "run",
      "target": "cat .gitignore 2>/dev/null"
    },
    {
      "action": "run",
      "target": "cat src/api/__init__.py; src/db/__init__.py;"
    },
    {
      "action": "run",
      "target": "python3 -m"
    },
    {
      "action": "run",
      "target": "python3 --version; 2>/dev/null;"
    },
    {
      "action": "run",
      "target": "mkdir -p .github/workflows"
    },
    {
      "action": "write",
      "target": ".github/workflows/ci.yml"
    },
    {
      "action": "write",
      "target": ".github/pull_request_template.md"
    },
    {
      "action": "write",
      "target": "CONTRIBUTING.md"
    },
    {
      "action": "run",
      "target": "python3 -m yaml.safe_load(open('.github/workflows/ci.yml'))\""
    },
    {
      "action": "run",
      "target": "git status"
    }
  ]
}
